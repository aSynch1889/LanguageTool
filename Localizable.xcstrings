    "When enabled, only missing translations will be generated. Existing translations will be preserved.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, werden nur fehlende Übersetzungen generiert. Bestehende Übersetzungen bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, only missing translations will be generated. Existing translations will be preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está habilitado, solo se generarán las traducciones que faltan. Las traducciones existentes se conservarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'activé, seules les traductions manquantes seront générées. Les traductions existantes seront conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, verranno generate solo le traduzioni mancanti. Le traduzioni esistenti verranno mantenute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、翻訳されていないものだけを生成します。既存の翻訳は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 누락된 번역만 생성됩니다. 기존 번역은 유지됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, apenas traduções ausentes serão geradas. As traduções existentes serão preservadas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดใช้งาน จะสร้างเฉพาะการแปลที่หายไปเท่านั้น การแปลที่มีอยู่จะได้รับการเก็บรักษาไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirildiğinde, yalnızca eksik çeviriler oluşturulacaktır. Mevcut çeviriler korunacaktır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，仅生成缺失的翻译。现有翻译将被保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，僅會產生遺漏的翻譯。現有的翻譯將會保留。"
          }
        }
      }
